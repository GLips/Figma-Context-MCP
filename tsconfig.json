{
  "compilerOptions": {
    "baseUrl": "./",
    // Spans the workspace root because the paths below pull member source into the program.
    // Nothing emits through tsc, so this only has to be wide enough to cover it.
    "rootDir": ".",
    "paths": {
      "~/*": ["./src/*"],
      // Resolve the bundled members here, NOT through their node_modules symlinks: TS marks
      // anything reached that way "from an external library" and silently won't emit declarations
      // for it, so `tsup --dts` dies on the raw .ts. workspace-paths-mirror-exports.test.ts fails
      // if an export subpath lands without a mapping. (vitest still resolves via the symlinks.)
      "@framelink/core": ["./core/src/index.ts"],
      "@framelink/core/snapshot": ["./core/src/snapshot.ts"],
      "@framelink/core/internal": ["./core/src/internal.ts"],
      "@framelink/plugin/schema": ["./plugin/src/preamble/schema.ts"],
      "@framelink/plugin/node-to-snapshot": ["./plugin/src/preamble/node-to-snapshot.ts"]
    },

    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,

    /* EMIT RULES */
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,

    "types": ["vitest/globals"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
