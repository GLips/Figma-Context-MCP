{
  "compilerOptions": {
    "baseUrl": "./",
    // The program spans the workspace root, not just src/: the paths below pull @framelink/plugin
    // source into it. Nothing emits through tsc (tsup owns the build, type-check is --noEmit), so
    // rootDir only has to be wide enough to cover every file in the program.
    "rootDir": ".",
    "paths": {
      "~/*": ["./src/*"],
      // @framelink/plugin is a workspace member, symlinked in as a devDependency and bundled
      // into dist rather than published. TS must not resolve it through that symlink: doing so
      // marks every file reached from it — including src/core/index.ts — as "from an external
      // library", and such files are silently unemittable, so `tsup --dts` gets no declaration
      // back for them, falls through to the raw .ts, and rollup's JS parser dies with
      // `Error parsing: src/core/index.ts:2:7`. The symlink itself stays load-bearing — vitest
      // resolves the plugin through it, not through these paths — so the devDependency is not
      // vestigial. Mirrors the plugin's exports map; src/tests/plugin-paths-mirror-exports.test.ts
      // fails if a new export subpath lands without a mapping here.
      "@framelink/plugin/schema": ["./plugin/src/preamble/schema.ts"],
      "@framelink/plugin/node-to-snapshot": ["./plugin/src/preamble/node-to-snapshot.ts"]
    },

    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,

    /* EMIT RULES */
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,

    "types": ["vitest/globals"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
