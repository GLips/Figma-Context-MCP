{
  "name": "figma-developer-mcp",
  "version": "0.13.2",
  "mcpName": "io.github.GLips/Figma-Context-MCP",
  "description": "Give your coding agent access to your Figma data. Implement designs in any framework in one-shot.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-developer-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --dts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js",
    "start:cli": "cross-env NODE_ENV=cli node dist/bin.js",
    "start:http": "node dist/bin.js",
    "dev": "cross-env NODE_ENV=development tsup",
    "dev:cli": "cross-env NODE_ENV=development tsup -- --stdio",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"core/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"core/**/*.ts\"",
    "scan-hidden-chars": "node scripts/scan-hidden-chars.mjs",
    "inspect": "pnpx @modelcontextprotocol/inspector",
    "benchmark:simplify": "tsx scripts/benchmark-simplify.ts",
    "prepack": "pnpm build && node scripts/verify-package-boundary.mjs --no-build",
    "typecheck:plugin": "pnpm --filter @framelink/plugin typecheck",
    "test:plugin": "pnpm --filter @framelink/plugin test",
    "build:plugin": "pnpm --filter @framelink/plugin build",
    "contract": "tsx scripts/bridge-contract.mjs",
    "probe:midrun-await": "tsx scripts/probe-midrun-await.mjs",
    "probe:commit-undo": "tsx scripts/probe-commit-undo.mjs",
    "docs:gen": "tsx scripts/gen-flcm-doc.ts",
    "docs:check": "tsx scripts/gen-flcm-doc.ts check",
    "validate": "pnpm scan-hidden-chars && pnpm format:check && pnpm lint && pnpm type-check && pnpm typecheck:core && pnpm typecheck:plugin && pnpm test && pnpm test:core && pnpm test:plugin && pnpm contract && pnpm build && pnpm build:plugin && pnpm docs:check",
    "payload-lab": "pnpm --filter @framelink/payload-lab dev",
    "test:payload-lab": "pnpm --filter @framelink/payload-lab test",
    "check:package": "node scripts/verify-package-boundary.mjs",
    "typecheck:core": "pnpm --filter @framelink/core typecheck",
    "test:core": "pnpm --filter @framelink/core test"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLips/Figma-Context-MCP.git"
  },
  "homepage": "https://www.framelink.ai",
  "keywords": [
    "figma",
    "mcp",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@figma/rest-api-spec": "^0.42.0",
    "@jimp/core": "^1.6.0",
    "@jimp/js-gif": "^1.6.0",
    "@jimp/js-jpeg": "^1.6.0",
    "@jimp/js-png": "^1.6.0",
    "@jimp/plugin-crop": "^1.6.0",
    "@jimp/plugin-resize": "^1.6.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "cleye": "^2.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ipaddr.js": "^2.4.0",
    "js-yaml": "^4.1.1",
    "posthog-node": "^5.29.2",
    "undici": "^7.25.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@framelink/core": "workspace:*",
    "@framelink/plugin": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.3.0",
    "lefthook": "^2.0.15",
    "prettier": "^3.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
